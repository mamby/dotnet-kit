<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mamby.Maui.Controls.Sheets.BottomSheetView"
             SafeAreaEdges="None"
             Padding="0"
             IsVisible="False">
    <Grid x:Name="RootLayout"
          SafeAreaEdges="None"
          HorizontalOptions="Fill"
          VerticalOptions="Fill"
          InputTransparent="False">
        <BoxView x:Name="Scrim"
                 Color="#66000000"
                 Opacity="0">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnScrimTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Grid SafeAreaEdges="SoftInput"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <Border x:Name="Sheet"
                    SafeAreaEdges="None"
                    HorizontalOptions="Fill"
                    VerticalOptions="End"
                    Margin="0"
                    Padding="20,8,20,20"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#090B11}"
                    StrokeShape="RoundRectangle 28,28,0,0">
                <Grid RowDefinitions="Auto,*"
                      SafeAreaEdges="None"
                      RowSpacing="0">
                    <Grid x:Name="SheetChrome"
                          HeightRequest="38"
                          BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnPullPanUpdated" />
                        </Grid.GestureRecognizers>

                        <Border WidthRequest="44"
                                HeightRequest="4"
                                HorizontalOptions="Center"
                                VerticalOptions="Start"
                                BackgroundColor="{AppThemeBinding Light=#C1C7D2, Dark=#93A0B7}"
                                Opacity="0.55"
                                StrokeShape="RoundRectangle 2">
                            <Border.GestureRecognizers>
                                <PanGestureRecognizer PanUpdated="OnPullPanUpdated" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <ScrollView x:Name="SheetScrollView"
                                Grid.Row="1"
                                SafeAreaEdges="None"
                                Orientation="Vertical"
                                VerticalOptions="Fill"
                                VerticalScrollBarVisibility="Never" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentView>
